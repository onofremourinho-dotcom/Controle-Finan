const PIN_FINGERPRINT='070c9d5ce367145768c1d7897fa916a1b37c6eef85e8118268695b1abcef8e28';
let unlocked=false, wrongAttempts=0, blockedUntil=0;
async function unlockPanel(pin){
 if(Date.now()<blockedUntil){$('#access-error').textContent='Aguarde alguns segundos antes de tentar novamente.';return;}
 try{
  if(!window.crypto?.subtle)throw Error('Abra o site usando HTTPS ou localhost para desbloquear.');
  const digest=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(pin));
  const hex=Array.from(new Uint8Array(digest)).map(b=>b.toString(16).padStart(2,'0')).join('');
  if(hex!==PIN_FINGERPRINT){wrongAttempts++;$('#access-error').textContent='Código incorreto.';
   if(wrongAttempts>=5){blockedUntil=Date.now()+30000;wrongAttempts=0;$('#access-error').textContent='Muitas tentativas. Aguarde 30 segundos.';}
   $('#access-pin').value='';$('#access-pin').focus();return;
  }
  wrongAttempts=0;unlocked=true;document.body.classList.remove('is-locked');$('#access-screen').hidden=true;
  $('#access-pin').value='';$('#access-error').textContent='';
  render();resumeCloudSession();
 }catch(e){$('#access-error').textContent=e.message;}
}
function lockPanel(){
 disconnectCloud();unlocked=false;document.body.classList.add('is-locked');$('#access-screen').hidden=false;
 closeModal();$('#access-pin').focus();
}
$('#access-form').addEventListener('submit',event=>{event.preventDefault();unlockPanel($('#access-pin').value.trim());});
$('#access-pin').focus();


// Somente após desbloquear o painel é iniciada a leitura do Realtime Database.
function resumeCloudSession(){connectCloud();}

</script>
