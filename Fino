function connectCloud(){
 if(!unlocked)return;
 const c=state.cloud;
 try{
  if(typeof firebase==='undefined')throw Error('Biblioteca Firebase indisponível; confira a conexão com a internet.');
  if(!c.app){c.app=firebase.initializeApp({databaseURL:FIREBASE_DATABASE_URL},'fino-pin-direct');c.db=c.app.database();}
  subscribeCloud();
 }catch(e){c.active=false;c.lastError=e.message||String(e);renderCloud();toast('Não foi possível conectar ao Firebase: '+c.lastError,'error');}
}
function subscribeCloud(){
 const c=state.cloud;if(!unlocked||!c.db)return;
 c.db.ref('/').off();c.db.ref('.info/connected').off();
 c.lastError='';c.listening=true;
 c.db.ref('.info/connected').on('value',snap=>{if(!unlocked)return;c.connected=snap.val()===true;renderCloud();},error=>{c.lastError='Status da conexão: '+error.message;renderCloud();});
 c.db.ref('/').on('value',snap=>{
  if(!unlocked)return;
  const remote=snap.val();c.lastError='';
  if(remote?.anos&&remote?.config){state.data=remote;if(!state.data.config.gastosFixos)state.data.config.gastosFixos=Object.fromEntries(DEFAULT_FIXED.map(x=>[x.id,x]));c.active=true;c.needsSeed=false;render();}
  else{c.active=false;c.needsSeed=true;renderCloud();}
 },error=>{if(!unlocked)return;c.active=false;c.needsSeed=false;c.lastError='Leitura recusada pelo Firebase: '+error.message;c.connected=false;renderCloud();toast('Firebase não permitiu a consulta. Verifique as regras do banco.','error');});
 renderCloud();
}
async function cloudSeed(local){
 if(!local&&!HAS_EMBEDDED_SEED){toast('Esta versão pública não inclui histórico. Importe um backup JSON primeiro.','error');return;}
 const c=state.cloud;if(!c.db||!unlocked){toast('Conecte-se ao Firebase primeiro.','error');return;}
 const data=clone(local?state.data:SEED);
 if(!data.config.gastosFixos)data.config.gastosFixos=Object.fromEntries(DEFAULT_FIXED.map(x=>[x.id,x]));
 if(!confirm(`Enviar ${local?'os dados abertos neste navegador':'a base histórica de 2025 e 2026'} ao Firebase? Somente se o banco estiver vazio; os dados existentes não serão substituídos.`))return;
 try{const result=await c.db.ref('/').transaction(current=>{if(current!==null&&Object.keys(current).length>0)return;return data;},undefined,false);
  if(!result.committed){toast('O Firebase já contém dados. A importação foi cancelada sem substituir nada.','error');return;}
  c.active=true;c.needsSeed=false;toast('Base histórica enviada ao Firebase.','success');
 }catch(e){c.lastError=e.message;renderCloud();toast('Falha ao importar: '+e.message,'error');}
}
function disconnectCloud(){const c=state.cloud;try{if(c.db){c.db.ref('/').off();c.db.ref('.info/connected').off();}}catch(e){}
 c.active=false;c.connected=false;c.listening=false;c.needsSeed=false;}
function exportBackup(){const blob=new Blob([JSON.stringify(state.data,null,2)],{type:'application/json;charset=utf-8'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='fino-backup-'+new Date().toISOString().slice(0,10)+'.json';document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000);toast('Backup JSON exportado.');}
async function importBackup(file){if(!file)return;try{const txt=await file.text();const data=JSON.parse(txt);if(!data||typeof data.anos!=='object'||typeof data.config!=='object')throw Error('Estrutura inválida: esperado anos e config.');if(!confirm('Substituir os dados atualmente abertos por este backup? Esta ação não pode ser desfeita sem outro backup.'))return;if(state.cloud.active){if(!confirm('Você está conectado ao Firebase. Esta importação substituirá TODOS os dados financeiros do banco remoto. Confirma novamente?'))return;await state.cloud.db.ref('/').set(data);}state.data=data;render();toast('Backup importado com sucesso.');}catch(e){toast('Importação não realizada: '+e.message,'error');}finally{$('#file-upload').value='';}}
function showNewMonth(){let p=nextYM(state.year,state.month);for(let i=0;i<36&&getMonth(p.y,p.m)&&p.y<=2027;i++)p=nextYM(p.y,p.m);if(p.y>2027)p={y:2027,m:12};showModal('Gerar um novo mês',`<p>Cria o período selecionado, copiando gastos fixos e receitas recorrentes. Todos os novos gastos começam como <strong>não pagos</strong>; o saldo anterior entra automaticamente.</p><form id="new-month-form"><div class="form-grid"><div class="field-group"><label class="field-label">Ano</label><select id="new-year" class="select" style="width:100%">${[2025,2026,2027].map(y=>`<option value="${y}" ${p.y===y?'selected':''}>${y}</option>`).join('')}</select></div><div class="field-group"><label class="field-label">Mês</label><select id="new-month" class="select" style="width:100%">${MONTHS.map((n,i)=>`<option value="${i+1}" ${p.m===i+1?'selected':''}>${n}</option>`).join('')}</select></div></div><div class="form-actions"><button type="button" class="button ghost" data-action="modal-close">Cancelar</button><button class="button primary" type="submit">Criar período</button></div></form>`);}

function renderReminders(){
 const stats=$('#billwatch-stats'),list=$('#billwatch-list');if(!stats||!list)return;
 const month=getMonth(state.year,state.month);
 if(!month){stats.innerHTML='';list.innerHTML='<div class="billwatch-ok">Este mês ainda não foi criado. Use “Novo mês” para gerar as contas fixas automaticamente.</div>';return;}
 const entries=objValues(month.gastos),fixed=getFixed();
 const missing=fixed.filter(f=>!entries.some(g=>fixedMatch(g.nome,f)));
 const unpaid=entries.filter(g=>!g.pago&&Number(g.valor)>0);
 const total=unpaid.reduce((n,g)=>n+Number(g.valor||0),0);
 stats.innerHTML=`<span class="billwatch-stat ${missing.length?'urgent':''}">${missing.length} conta(s) fixa(s) ausente(s)</span><span class="billwatch-stat ${unpaid.length?'urgent':''}">${unpaid.length} despesa(s) pendente(s) · ${money(total)}</span>`;
 if(!missing.length&&!unpaid.length){list.innerHTML='<div class="billwatch-ok">Tudo conferido: as contas fixas estão cadastradas e não há despesas pendentes neste mês.</div>';return;}
 const missingHtml=missing.map(f=>`<div class="billwatch-item"><span style="color:#efbb66">!</span><div class="grow"><strong>${esc(f.nome)}</strong><small>Conta recorrente não encontrada${f.diaVencimento?' · vence dia '+f.diaVencimento:''}</small></div><span class="amount">${money(f.valor)}</span><button class="button sm ghost" data-action="add-missing-fixed" data-id="${esc(f.id)}">Lançar</button></div>`).join('');
 const unpaidHtml=unpaid.map(g=>`<div class="billwatch-item"><span style="color:#ef6666">○</span><div class="grow"><strong>${esc(g.nome)}</strong><small>Ainda não marcado como pago</small></div><span class="amount">${money(g.valor)}</span><button class="button sm ghost" data-action="edit-expense" data-year="${state.year}" data-month="${state.month}" data-id="${esc(g.id)}">Abrir</button></div>`).join('');
 list.innerHTML=missingHtml+unpaidHtml;
}
async function addMissingFixed(id){
 const fixed=state.data.config.gastosFixos?.[id];if(!fixed)return;
 const y=state.year,m=state.month;if(!getMonth(y,m)){toast('Crie o mês primeiro.','error');return;}
 if(objValues(getMonth(y,m).gastos).some(g=>fixedMatch(g.nome,fixed))){toast('Esta conta já está lançada.','info');return;}
 const expenseId=ident();await savePath(`/anos/${y}/meses/${pad(m)}/gastos/${expenseId}`,{id:expenseId,nome:fixed.nome,valor:cents(fixed.valor),pago:false,recorrente:true});toast('Conta recorrente adicionada ao mês.');
}

