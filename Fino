 }else if(form.id==='adjust-form'){const y=Number(form.dataset.year),m=Number(form.dataset.month);await savePath(`/anos/${y}/meses/${pad(m)}/ajusteTransporte`,calculate($('#adj-carry').value));await savePath(`/anos/${y}/meses/${pad(m)}/ajusteConciliacao`,calculate($('#adj-conc').value));closeModal();toast('Ajustes atualizados em cascata.');
 }else if(form.id==='reserve-form'){
  const type=$('#reserve-type').value,amount=calculate($('#reserve-amount').value),desc=$('#reserve-desc').value.trim()||'Transferência da caixinha';if(amount<=0)throw Error('Informe um valor positivo.');if(!getMonth(state.year,state.month))throw Error('Crie o mês selecionado para registrar a transferência.');const orig=state.data.config.caixinha||{saldo:0,movimentos:{}};if(type==='retirada'&&amount>orig.saldo)throw Error('Saldo insuficiente na caixinha.');const diff=type==='aporte'?amount:-amount;const id=ident();const obj={id,nome:desc,valor:diff,tipo:type,data:new Date().toISOString(),mes:key(state.year,state.month)};const entry={id,nome:type==='aporte'?'Aporte caixinha: '+desc:'Retirada caixinha: '+desc,valor:-diff};
  const changes={[`config/caixinha/movimentos/${id}`]:obj,'config/caixinha/saldo':cents(orig.saldo+diff),[`anos/${state.year}/meses/${pad(state.month)}/entradas/${id}`]:entry};
  for(const [path,value] of Object.entries(changes))setByPath('/'+path,value);saveLocal();render();
  if(state.cloud.active){try{await state.cloud.db.ref('/').update(changes);}catch(e){toast('Transferência salva localmente, mas a nuvem não confirmou: '+e.message,'error');}}
  closeModal();toast('Reserva e saldo mensal atualizados.');
 }else if(form.id==='fixed-form'){const id=form.dataset.id||ident(),name=$('#fixed-name').value.trim(),value=calculate($('#fixed-value').value);if(!name||value<0)throw Error('Nome e valor positivo são obrigatórios.');const due=Number($('#fixed-due').value||0);if(due&&(due<1||due>31))throw Error('Dia de vencimento deve ficar entre 1 e 31.');await savePath(`/config/gastosFixos/${id}`,{id,nome:name,valor:value,...(due?{diaVencimento:due}:{})});showFixed();toast('Modelo de gasto recorrente salvo.');
 }else if(form.id==='sub-form'){const id=form.dataset.id||ident(),name=$('#sub-name').value.trim(),value=calculate($('#sub-value').value);if(!name||value<0)throw Error('Nome e valor não negativo são obrigatórios.');await savePath(`/config/assinaturas/${id}`,{id,nome:name,valor:value});showSubs();toast('Assinatura salva.');
 }else if(form.id==='project-form'){const id=form.dataset.id||ident(),p=state.data.config.projetos?.[id],name=$('#project-name').value.trim(),total=calculate($('#project-total').value),adjust=calculate($('#project-adjust').value);if(!name||total<0)throw Error('Informe nome e valor inicial válido.');const original=p?.ajustes||{};const existingOther=sum(objValues(original).filter(x=>x.id!=='manual').map(x=>x.valor));const result={...(p||{}),id,nome:name,total,movimentos:p?.movimentos||{},ajustes:{...original,manual:{id:'manual',nome:'Ajuste manual',valor:cents(adjust-existingOther)}}};await savePath(`/config/projetos/${id}`,result);showProjectEdit(id);toast('Projeto salvo.');
 }else if(form.id==='project-expense-form'){const pid=form.dataset.project,id=form.dataset.id||ident(),name=$('#p-exp-name').value.trim(),amount=calculate($('#p-exp-value').value);if(!name||amount<0)throw Error('Informe descrição e valor válido.');await savePath(`/config/projetos/${pid}/movimentos/${id}`,{id,nome:name,valor:amount,pago:true});showProjectEdit(pid);toast('Movimentação registrada.');
 }
 }catch(e){toast(e.message||String(e),'error');}
});
