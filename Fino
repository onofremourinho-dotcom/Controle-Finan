// Fórmulas financeiras sem eval(): operadores +, -, *, / e parênteses.
function parseCurrencyText(raw){let s=String(raw).trim().replace(/R\$|\s/g,'');if(!/^\d[\d.,]*$/.test(s))throw Error('Número inválido.');
 if(s.includes(',')&&s.includes('.')){const lastDot=s.lastIndexOf('.')>s.lastIndexOf(',');s=lastDot?s.replace(/,/g,''):s.replace(/\./g,'').replace(',','.');}
 else if(s.includes(',')){s=s.replace(/\./g,'').replace(',','.');}
 else if((s.match(/\./g)||[]).length>1 || /^\d{1,3}\.\d{3}$/.test(s)){s=s.replace(/\./g,'');}
 let x=Number(s);if(!Number.isFinite(x))throw Error('Número inválido');return x;}
function calculate(input){const s=String(input??'').trim();if(!s)throw Error('Informe um valor ou expressão.');const tokens=[];let i=0;
 while(i<s.length){if(/\s/.test(s[i])){i++;continue;}if('+-*/()'.includes(s[i])){tokens.push(s[i]);i++;continue;}if(/[\d.,]/.test(s[i])){let j=i+1;while(j<s.length&&/[\d.,]/.test(s[j]))j++;tokens.push(parseCurrencyText(s.slice(i,j)));i=j;continue;}throw Error('Caractere não permitido na expressão.');}
 let pos=0;function factor(){const v=tokens[pos++];if(v==='+')return factor();if(v==='-')return -factor();if(v==='('){const x=expr();if(tokens[pos++]!==')')throw Error('Parênteses inválidos.');return x;}if(typeof v==='number')return v;throw Error('Expressão inválida.');}
 function term(){let a=factor();while(tokens[pos]==='*'||tokens[pos]==='/'){const op=tokens[pos++],b=factor();if(op==='/'&&b===0)throw Error('Divisão por zero.');a=op==='*'?a*b:a/b;}return a;}
 function expr(){let a=term();while(tokens[pos]==='+'||tokens[pos]==='-'){const op=tokens[pos++],b=term();a=op==='+'?a+b:a-b;}return a;}
 const result=expr();if(pos!==tokens.length||!Number.isFinite(result))throw Error('Expressão inválida.');if(Math.abs(result)>1e12)throw Error('Valor acima do limite permitido.');return cents(result);
}
