function showProjectEdit(id){const p=state.data.config.projetos?.[id];const k=p?projectCalculations(p):null;showModal(p?`Editar fundo: ${p.nome}`:'Novo fundo especial',`<form id="project-form" data-id="${esc(id||'')}"><div class="form-grid"><div class="field-group full"><label class="field-label">Projeto</label><input id="project-name" class="field" maxlength="100" required value="${esc(p?.nome||'')}"></div><div class="field-group"><label class="field-label">Total disponível originalmente</label><input id="project-total" class="field" required value="${esc(p?.total??'')}"></div><div class="field-group"><label class="field-label">Ajuste adicional</label><input id="project-adjust" class="field" value="${esc(k?.adjust??0)}"><div class="field-hint">Conciliação manual preservada.</div></div></div><div class="form-actions"><button type="button" class="button ghost" data-action="manage-projects">Voltar</button><button class="button primary" type="submit">Salvar fundo</button></div></form>${p?`<hr style="border:0;border-top:1px solid #2c3844;margin:24px 0"><div class="section-head"><strong>Despesas deste fundo</strong><button class="button sm primary" data-action="edit-project-expense" data-project="${esc(p.id)}">${icon('plus')} Movimentação</button></div><div class="modal-list">${objValues(p.movimentos).map(x=>`<div class="modal-list-row"><label>${esc(x.nome)}</label><strong class="mono">${money(x.valor)}</strong><button class="button flat" data-action="edit-project-expense" data-project="${esc(p.id)}" data-id="${esc(x.id)}">${icon('edit')}</button></div>`).join('')}</div>`:''}`,true);}
function showProjectExpense(projectId,id){const p=state.data.config.projetos?.[projectId],v=p?.movimentos?.[id];if(!p)return;showModal(`${v?'Editar':'Adicionar'} movimentação · ${p.nome}`,`<form id="project-expense-form" data-project="${esc(projectId)}" data-id="${esc(id||'')}"><div class="form-grid"><div class="field-group full"><label class="field-label">Descrição</label><input class="field" id="p-exp-name" required value="${esc(v?.nome||'')}"></div><div class="field-group full"><label class="field-label">Valor</label><input class="field" id="p-exp-value" required value="${esc(v?.valor??'')}"></div></div><div class="form-actions">${v?`<button type="button" class="button danger" data-action="delete-project-expense" data-project="${esc(projectId)}" data-id="${esc(id)}">Excluir</button>`:''}<button type="button" class="button ghost" data-action="edit-project" data-id="${esc(projectId)}">Voltar</button><button class="button primary" type="submit">Salvar</button></div></form>`);}
